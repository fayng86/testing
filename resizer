<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bulk Folder Image Resizer</title>
    <!-- Libraries for ZIP and High-Quality Resizing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pica/9.0.1/pica.min.js"></script>
    <style>
        body { font-family: sans-serif; max-width: 800px; margin: 40px auto; padding: 20px; line-height: 1.6; background: #f4f7f6; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .controls { display: flex; flex-direction: column; gap: 15px; margin-bottom: 20px; }
        input[type="number"], input[type="file"] { padding: 10px; border: 1px solid #ddd; border-radius: 4px; }
        button { padding: 12px; cursor: pointer; border: none; border-radius: 4px; font-weight: bold; transition: 0.2s; }
        #startBtn { background: #2ecc71; color: white; }
        #startBtn:disabled { background: #bdc3c7; cursor: not-allowed; }
        #downloadBtn { background: #3498db; color: white; display: none; margin-top: 10px; }
        .progress-bar { height: 10px; width: 0%; background: #2ecc71; transition: width 0.3s; border-radius: 5px; }
        .progress-container { background: #eee; border-radius: 5px; margin-top: 15px; display: none; }
        #status { font-weight: bold; margin-top: 10px; }
    </style>
</head>
<body>

<div class="card">
    <h1>Bulk Folder Resizer</h1>
    <p>Select a folder. All images will be resized and packed into a ZIP file locally.</p>

    <div class="controls">
        <label>Step 1: Set Maximum Width (pixels)</label>
        <input type="number" id="maxWidth" value="1200" min="100">
        
        <label>Step 2: Select Folder</label>
        <input type="file" id="folderInput" webkitdirectory directory multiple>
        
        <button id="startBtn">Start Resizing</button>
    </div>

    <div class="progress-container" id="progressWrap">
        <div class="progress-bar" id="progressBar"></div>
    </div>
    <div id="status">Ready</div>
    <button id="downloadBtn">Download Resized ZIP</button>
</div>

<script>
    const folderInput = document.getElementById('folderInput');
    const startBtn = document.getElementById('startBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const status = document.getElementById('status');
    const progressBar = document.getElementById('progressBar');
    const progressWrap = document.getElementById('progressWrap');
    
    const pica = window.pica();
    let zipBlob = null;

    startBtn.addEventListener('click', async () => {
        const files = Array.from(folderInput.files).filter(f => f.type.startsWith('image/'));
        if (files.length === 0) return alert("Please select a folder containing images.");

        const maxWidth = parseInt(document.getElementById('maxWidth').value);
        const zip = new JSZip();
        
        startBtn.disabled = true;
        downloadBtn.style.display = 'none';
        progressWrap.style.display = 'block';

        for (let i = 0; i < files.length; i++) {
            const file = files[i];
            status.innerText = `Processing: ${file.name} (${i + 1}/${files.length})`;
            progressBar.style.width = `${((i + 1) / files.length) * 100}%`;

            try {
                const resizedBlob = await resizeImage(file, maxWidth);
                // Maintain folder structure using webkitRelativePath
                zip.file(file.webkitRelativePath || file.name, resizedBlob);
            } catch (err) {
                console.error("Error processing " + file.name, err);
            }
        }

        status.innerText = "Generating ZIP file...";
        zipBlob = await zip.generateAsync({ type: "blob" });
        
        status.innerText = "Done! Resized " + files.length + " images.";
        downloadBtn.style.display = 'block';
        startBtn.disabled = false;
    });

    downloadBtn.addEventListener('click', () => {
        const link = document.createElement('a');
        link.href = URL.createObjectURL(zipBlob);
        link.download = "resized_images.zip";
        link.click();
    });

    function resizeImage(file, maxWidth) {
        return new Promise((resolve) => {
            const img = new Image();
            img.src = URL.createObjectURL(file);
            img.onload = async () => {
                const scale = maxWidth / img.width;
                if (scale >= 1) { // Don't upscale
                    resolve(file);
                    return;
                }

                const canvas = document.createElement('canvas');
                canvas.width = maxWidth;
                canvas.height = img.height * scale;

                await pica.resize(img, canvas);
                const blob = await pica.toBlob(canvas, 'image/jpeg', 0.85);
                resolve(blob);
            };
        });
    }
</script>

</body>
</html>
